<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.5.0</Version>
    <Authors>David Simon</Authors>
    <Product>PivotScope</Product>
    <Copyright>Copyright (c) 2026 David Simon</Copyright>
  </PropertyGroup>

  <!-- The CubeScope submodule has its own conventions: do not impose ours on it
       (it does not use TreatWarningsAsErrors and has no need to in order to serve us). -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('external'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
