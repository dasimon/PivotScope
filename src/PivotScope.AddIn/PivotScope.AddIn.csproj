<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Excel-DNA: only one .NET Core runtime can be loaded in an Excel
         process. RollForward=Major lets us coexist with another add-in
         that has already loaded a newer version. -->
    <RollForward>Major</RollForward>
    <ExcelAddInFileName>PivotScope</ExcelAddInFileName>

    <!-- The project is x64 only (CubeScope.Core, ADOMD, 64-bit Excel).
         By default Excel-DNA produces TWO files: PivotScope.xll for 32-bit
         and PivotScope64.xll for 64-bit. Loading the 32-bit one into a 64-bit
         Excel fails with a misleading message — "le format et l'extension du
         fichier ne correspondent pas" — that suggests a corrupted
         file. So only the 64-bit one is generated: a single deliverable, no
         wrong choice possible.
         The 64 suffix cannot be removed (the targets treat an empty value
         as "not set" and reapply their default), and that is just
         fine: the name tells the bitness. -->
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>

    <!-- Self-contained deliverable. Without PackNativeLibraryDependencies, the packed .xll
         only contains the managed assemblies: moved on its own, it crashes on the
         first SQLite write (e_sqlite3.dll not found). That is exactly
         the pitfall hit on CubeScope, where the moved exe looked for its native
         DLLs next to itself. -->
    <ExcelDnaPackNativeLibraryDependencies>true</ExcelDnaPackNativeLibraryDependencies>
    <ExcelDnaPackManagedDependencies>true</ExcelDnaPackManagedDependencies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" />
    <PackageReference Include="ExcelDna.Interop" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PivotScope.Core\PivotScope.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SpaDir>$(MSBuildThisFileDirectory)..\PivotScope.Web</SpaDir>
    <SpaDist>$(SpaDir)\dist</SpaDist>
  </PropertyGroup>

  <!-- Incremental SPA build: npm is only rerun if a source has changed.
       -p:SkipSpaBuild=true to compile the C# alone (fast iteration). -->
  <Target Name="BuildSpa"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SkipSpaBuild)' != 'true' AND Exists('$(SpaDir)\node_modules')"
          Inputs="@(SpaSource)"
          Outputs="$(SpaDist)\index.html">
    <ItemGroup>
      <SpaSource Include="$(SpaDir)\src\**\*.*;$(SpaDir)\index.html;$(SpaDir)\package.json;$(SpaDir)\vite.config.ts" />
    </ItemGroup>
    <Exec Command="npm run build" WorkingDirectory="$(SpaDir)" />
  </Target>

  <!-- Embedding the SPA in the assembly: the add-in then needs no file
       at all on disk to serve its interface.
       Four MSBuild pitfalls already paid for on CubeScope:
       (a) hook PrepareForBuild — at CoreCompile the resource list is
           already frozen and zero files get embedded, silently;
       (b) go through a qualified intermediate item: on a self-referencing
           Include, %(Filename) evaluates to empty and all LogicalNames
           collide (CS1508);
       (c) the glob **\*.* and not **\*, which also matches folders;
       (d) %(RecursiveDir) renders a BACKSLASH separator on Windows. Without
           normalization, the Monaco worker gets embedded as "spa/assets\x.js"
           while the URL requests "spa/assets/x.js": silent 404, and
           the editor does not start. -->
  <Target Name="EmbedSpa" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildSpa">
    <ItemGroup>
      <_SpaFile Include="$(SpaDist)\**\*.*" />
      <EmbeddedResource Include="@(_SpaFile)">
        <LogicalName>spa/$([System.String]::Copy('%(_SpaFile.RecursiveDir)').Replace('\','/'))%(_SpaFile.Filename)%(_SpaFile.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Error Condition="'@(_SpaFile)' == ''"
           Text="The SPA is not built. Run 'npm ci &amp;&amp; npm run build' in src/PivotScope.Web." />
  </Target>

  <!-- The WebView2 package ships the WPF control in addition to the WinForms control.
       Only WinForms is used (the only one exposable as ActiveX for a CustomTaskPane),
       and the WPF control's presence causes an MSB3277 conflict on WindowsBase 4.0 vs 5.0.
       Remove the unused reference rather than hide the warning.
       It must be removed BEFORE ResolveAssemblyReferences: that very
       target emits MSB3277, so cleaning it up afterwards is useless. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
