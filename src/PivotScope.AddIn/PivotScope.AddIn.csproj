<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Excel-DNA : un seul runtime .NET Core peut être chargé dans un process
         Excel. RollForward=Major permet de cohabiter avec un autre complément
         qui aurait déjà chargé une version plus récente. -->
    <RollForward>Major</RollForward>
    <ExcelAddInFileName>PivotScope</ExcelAddInFileName>

    <!-- Le projet est x64 uniquement (CubeScope.Core, ADOMD, Excel 64 bits).
         Excel-DNA produit par défaut DEUX fichiers : PivotScope.xll en 32 bits
         et PivotScope64.xll en 64 bits. Charger le 32 bits dans un Excel 64
         bits échoue avec un message trompeur — « le format et l'extension du
         fichier ne correspondent pas » — qui laisse croire à un fichier
         corrompu. On ne génère donc que le 64 bits : un seul livrable, aucun
         mauvais choix possible.
         Le suffixe 64 n'est pas supprimable (les targets traitent une valeur
         vide comme « non défini » et rappliquent leur défaut), et c'est très
         bien ainsi : le nom dit la bitness. -->
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>

    <!-- Livrable autonome. Sans PackNativeLibraryDependencies, le .xll empaqueté
         ne contient que les assemblies managées : déplacé seul, il plante à la
         première écriture SQLite (e_sqlite3.dll introuvable). C'est exactement
         le piège rencontré sur CubeScope, où l'exe déplacé cherchait ses DLL
         natives à côté de lui. -->
    <ExcelDnaPackNativeLibraryDependencies>true</ExcelDnaPackNativeLibraryDependencies>
    <ExcelDnaPackManagedDependencies>true</ExcelDnaPackManagedDependencies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" />
    <PackageReference Include="ExcelDna.Interop" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PivotScope.Core\PivotScope.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SpaDir>$(MSBuildThisFileDirectory)..\PivotScope.Web</SpaDir>
    <SpaDist>$(SpaDir)\dist</SpaDist>
  </PropertyGroup>

  <!-- Build de la SPA, incrémental : on ne relance npm que si une source a bougé.
       -p:SkipSpaBuild=true pour compiler le C# seul (itération rapide). -->
  <Target Name="BuildSpa"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SkipSpaBuild)' != 'true' AND Exists('$(SpaDir)\node_modules')"
          Inputs="@(SpaSource)"
          Outputs="$(SpaDist)\index.html">
    <ItemGroup>
      <SpaSource Include="$(SpaDir)\src\**\*.*;$(SpaDir)\index.html;$(SpaDir)\package.json;$(SpaDir)\vite.config.ts" />
    </ItemGroup>
    <Exec Command="npm run build" WorkingDirectory="$(SpaDir)" />
  </Target>

  <!-- Embarquement de la SPA dans l'assembly : l'add-in n'a alors plus besoin
       d'aucun fichier sur disque pour servir son interface.
       Trois pièges MSBuild déjà payés sur CubeScope :
       (a) hooker PrepareForBuild — à CoreCompile la liste des ressources est
           déjà figée et l'on embarque zéro fichier, en silence ;
       (b) passer par un item intermédiaire qualifié : sur un Include
           auto-référencé, %(Filename) s'évalue vide et tous les LogicalName
           entrent en collision (CS1508) ;
       (c) le glob **\*.* et non **\*, qui matche aussi les dossiers ;
       (d) %(RecursiveDir) rend un séparateur ANTISLASH sous Windows. Sans
           normalisation, le worker Monaco s'embarque en « spa/assets\x.js »
           alors que l'URL demande « spa/assets/x.js » : 404 silencieux, et
           l'éditeur ne démarre pas. -->
  <Target Name="EmbedSpa" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildSpa">
    <ItemGroup>
      <_SpaFile Include="$(SpaDist)\**\*.*" />
      <EmbeddedResource Include="@(_SpaFile)">
        <LogicalName>spa/$([System.String]::Copy('%(_SpaFile.RecursiveDir)').Replace('\','/'))%(_SpaFile.Filename)%(_SpaFile.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Error Condition="'@(_SpaFile)' == ''"
           Text="La SPA n'est pas construite. Lancez 'npm ci &amp;&amp; npm run build' dans src/PivotScope.Web." />
  </Target>

  <!-- Le paquet WebView2 embarque le contrôle WPF en plus du contrôle WinForms.
       On n'utilise que WinForms (seul exposable en ActiveX pour un CustomTaskPane),
       et sa présence provoque un conflit MSB3277 sur WindowsBase 4.0 vs 5.0.
       On retire la référence inutilisée plutôt que de masquer l'avertissement.
       Il faut la retirer AVANT ResolveAssemblyReferences : c'est cette
       cible elle-même qui émet MSB3277, donc la nettoyer après ne sert à rien. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
